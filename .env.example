# Database (MongoDB replica set required for transactions in production)
MONGODB_URI=mongodb://127.0.0.1:27017/m2stores

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=m2s_token

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=M2Stores
NEXT_PUBLIC_CURRENCY_SYMBOL=₹

# Optional analytics beacon (provider-independent; omit to log to console only)
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# PhonePe Payment Gateway (PG v1 salt-based; sandbox defaults)
# HOST must be the API root WITHOUT a trailing path, e.g.:
#   Sandbox:    https://api-preprod.phonepe.com/apis/pg-sandbox
#   Production: https://api.phonepe.com/apis/hermes
PHONEPE_MERCHANT_ID=your_merchant_id
PHONEPE_SALT_KEY=your_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT
PHONEPE_HOST_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# Cloudinary (product media)
CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Initial Super Admin (for seed script only — never commit real secrets)
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=ChangeThisToAStrongPassword!

# Cron / background jobs (protect /api/inventory/expire)
CRON_SECRET=change-me-in-production
